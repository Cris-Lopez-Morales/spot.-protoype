{
  "name": "spot-with-local-ai",
  "version": "4.6.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "vendor": "node scripts/prepare-vendor.mjs",
    "setup": "npm install --ignore-scripts && npm run vendor",
    "models": "node scripts/mirror-models.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "python tests/integration_browser.py",
    "test:live": "node tests/live-server.mjs",
    "launch": "node scripts/start.mjs",
    "test:map": "node --test tests/spot/*.test.cjs",
    "test:integration": "python tests/integration_browser.py",
    "test:map-ui": "python tests/map_v46_browser.py",
    "build:preview": "node scripts/build-map-preview.mjs"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.85",
    "@wllama/wllama": "3.6.1",
    "@wllama/wllama-compat": "3.6.1",
    "@huggingface/transformers": "4.3.0",
    "dompurify": "3.4.16",
    "marked": "18.0.14",
    "highlight.js": "11.12.0",
    "pdfjs-dist": "6.3.289",
    "pyodide": "314.0.7"
  },
  "devDependencies": {
    "esbuild": "0.27.2"
  },
  "overrides": {
    "loglevel": "1.9.1",
    "@huggingface/jinja": "0.5.10",
    "@huggingface/tokenizers": "0.2.0",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0"
  }
}
